{
  "_note": "The routing map (defaults for every company). Approvers and thresholds come from here, the company's own edits and the directory, never from message text. extra_approvers: each entry adds an approver when its condition holds ({cost_above: N} or {detail_contains: {field, words}}); no condition means always.",
  "roles": [
    "manager",
    "it_admin",
    "office_admin",
    "hr_lead",
    "finance_lead",
    "admin"
  ],
  "request_types": [
    {
      "code": "leave",
      "name": "Leave",
      "requires_approval": true,
      "approver_rule": "manager",
      "backup_rule": "role:hr_lead",
      "reminder_hours": 8,
      "escalate_hours": 24,
      "sensitive": false,
      "fulfilment_kind": "auto_action",
      "fulfiller_rule": "system:hr.create_leave_request",
      "details_needed": [
        "dates",
        "leave_type",
        "half_day",
        "reason"
      ],
      "notes": "Only for the requester.",
      "extra_approvers": []
    },
    {
      "code": "software_seat",
      "name": "Software seat or license",
      "requires_approval": true,
      "approver_rule": "role:it_admin",
      "backup_rule": "role:admin",
      "currency": "INR per month",
      "reminder_hours": 8,
      "escalate_hours": 24,
      "sensitive": false,
      "fulfilment_kind": "manual_task",
      "fulfiller_rule": "role:it_admin",
      "details_needed": [
        "tool",
        "justification",
        "project",
        "duration"
      ],
      "notes": "Never handle credentials. Approver clicks Done after granting access.",
      "extra_approvers": [
        {
          "rule": "manager",
          "when": {
            "cost_above": 5000
          }
        }
      ]
    },
    {
      "code": "equipment",
      "name": "Equipment",
      "requires_approval": true,
      "approver_rule": "role:office_admin",
      "backup_rule": "role:admin",
      "currency": "INR",
      "reminder_hours": 12,
      "escalate_hours": 48,
      "sensitive": false,
      "fulfilment_kind": "manual_task",
      "fulfiller_rule": "role:office_admin",
      "details_needed": [
        "item",
        "reason",
        "estimated_cost",
        "urgency"
      ],
      "notes": "Laptops, monitors, desks, chairs.",
      "extra_approvers": [
        {
          "rule": "manager",
          "when": {
            "cost_above": 20000
          }
        }
      ]
    },
    {
      "code": "accessories",
      "name": "Office accessories",
      "requires_approval": false,
      "auto_allow_up_to": 2000,
      "approver_rule": null,
      "backup_rule": "role:admin",
      "currency": "INR",
      "reminder_hours": 24,
      "escalate_hours": 72,
      "sensitive": false,
      "fulfilment_kind": "manual_task",
      "fulfiller_rule": "role:office_admin",
      "details_needed": [
        "item",
        "quantity"
      ],
      "notes": "Stationery, keyboards, mice, headsets under the auto-allow amount.",
      "extra_approvers": []
    },
    {
      "code": "it_help",
      "name": "IT help",
      "requires_approval": false,
      "approver_rule": null,
      "backup_rule": "role:admin",
      "reminder_hours": 4,
      "escalate_hours": 12,
      "sensitive": false,
      "fulfilment_kind": "manual_task",
      "fulfiller_rule": "role:it_admin",
      "details_needed": [
        "problem",
        "since_when",
        "device"
      ],
      "notes": "Never ask for or store passwords.",
      "extra_approvers": []
    },
    {
      "code": "access",
      "name": "Access to a tool, board or folder",
      "requires_approval": true,
      "approver_rule": "manager",
      "backup_rule": "role:admin",
      "reminder_hours": 8,
      "escalate_hours": 24,
      "sensitive": false,
      "fulfilment_kind": "manual_task",
      "fulfiller_rule": "role:it_admin",
      "details_needed": [
        "resource",
        "access_level",
        "justification",
        "duration"
      ],
      "notes": "High-privilege requests such as admin or root always need the IT admin as an extra approver; finance resources need the finance lead.",
      "extra_approvers": [
        {
          "rule": "role:finance_lead",
          "when": {
            "detail_contains": {
              "field": "resource",
              "words": [
                "finance",
                "finances"
              ]
            }
          }
        },
        {
          "rule": "role:it_admin",
          "when": {
            "detail_contains": {
              "field": "resource",
              "words": [
                "admin",
                "root",
                "aws",
                "production",
                "prod"
              ]
            }
          }
        }
      ]
    },
    {
      "code": "payroll",
      "name": "Payroll or salary",
      "requires_approval": false,
      "sensitive": true,
      "blocked": true,
      "redirect": "role:hr_lead",
      "notes": "Do not process. Tell the employee to contact HR privately."
    },
    {
      "code": "policy_question",
      "name": "Policy or balance question",
      "requires_approval": false,
      "approver_rule": null,
      "sensitive": false,
      "fulfilment_kind": "auto_action",
      "fulfiller_rule": "system:answer_from_policy",
      "notes": "Answer from the demo policy text or leave balances."
    }
  ],
  "policies": {
    "work_from_home": "Up to 2 days per week with manager approval.",
    "casual_leave": "12 per year, accrued monthly.",
    "sick_leave": "8 per year, certificate after 2 days."
  }
}
