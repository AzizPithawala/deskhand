# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
DESKHAND_MODEL=claude-haiku-5-5
DESKHAND_AI_BUDGET_PER_DAY=200
DESKHAND_RATE_LIMIT_PER_MIN=20

# viaSocket (copy from https://flow.viasocket.com/integrations; never commit)
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_API_URL=https://flow-api.viasocket.com
VIASOCKET_RUN_URL=https://flow.sokt.io
VIASOCKET_EMBED_SECRET=
DESKHAND_INGEST_SECRET=
DESKHAND_TENANT_ID=acme-demo

# Where links in notification messages point (the Deskhand inbox).
DESKHAND_BASE_URL=http://localhost:8000

# Optional extra HTTP Basic gate in front of everything (any user name). Leave empty: the app has its own sign-in.
DESKHAND_DEMO_PASSWORD=

# Where all data lives: platform.db plus one database file per company. Hosted: the root main.py sets this from DATA_DIR.
DESKHAND_DATA_DIR=.deskhand
# Invite codes for registering a new company, comma separated, each works once. Secret. Empty means registration is closed.
# On Embarko set it yourself in App setup; never write real codes into a file in the repository.
DESKHAND_SIGNUP_CODES=
